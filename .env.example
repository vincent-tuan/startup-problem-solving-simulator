DATABASE_URL=postgres://user:password@host/database?sslmode=require
SESSION_PEPPER=replace-with-at-least-32-random-bytes
RECOVERY_PEPPER=replace-with-a-different-32-byte-secret
# Development and test only. Production refuses ephemeral persistence.
ALLOW_EPHEMERAL_STORE=1
# Optional. When either value is absent, stakeholder dialogue uses authored fallback.
OPENAI_API_KEY=
OPENAI_DIALOGUE_MODEL=
# Optional. Competitor decisions fall back to a deterministic authored policy.
OPENAI_AGENT_MODEL=
# Optional split: fast regular turns and stronger critical/deep turns.
OPENAI_AGENT_FAST_MODEL=
OPENAI_AGENT_DEEP_MODEL=
# Optional daily shared dossier workflow using the Responses API web_search tool.
OPENAI_MARKET_MODEL=
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Used by Vercel Cron / the internal daily market refresh endpoint.
CRON_SECRET=
